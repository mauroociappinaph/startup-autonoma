{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PATH", "PYTHONPATH", "PYTHONHOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@startup/protos#generate"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "next.config.js"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@startup/protos#generate": {
      "inputs": ["proto/**/*.proto", "scripts/generate.sh"],
      "outputs": ["src/generated/**", "../../ai-engine/app/grpc_generated/**"]
    },
    "test": {
      "inputs": ["src/**", "package.json", "tsconfig.json", "jest.config.js"],
      "outputs": []
    },
    "test:fast": {
      "inputs": ["src/**", "package.json", "tsconfig.json", "jest.config.js"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", ".eslintrc.json", "package.json"],
      "outputs": []
    },
    "check": {
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": true,
      "outputs": ["prisma/client/**"]
    },
    "db:push": {
      "cache": false,
      "persistent": false
    }
  }
}
