{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && tsc-alias",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests --detectOpenHandles",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "format": "prettier --write 'src/**/*.ts'",
    "test:business": "tsx src/test-business-workflow.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "latest",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/groq": "^1.2.0",
    "@langchain/langgraph": "latest",
    "@langchain/langgraph-checkpoint-redis": "^1.0.4",
    "@langchain/openai": "^1.4.4",
    "bullmq": "^5.74.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "ioredis": "^5.10.1",
    "redis": "^4.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google-protobuf": "^3.15.12",
    "@types/jest": "^30.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-mock": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  }
}
