#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

export PATH=$PATH:/usr/local/bin:/usr/bin:/bin

# Detectamos la rama actual
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "=========================================================="
echo "🏎️  ANTIGRAVITY: Turbo-Differential Mode (Pre-Push)"
echo "=========================================================="

# 1. Verificación de tipos y tests solo en paquetes modificados
# Usamos turbo para detectar cambios respecto a origin/develop
echo "⚡ Validando cambios respecto a origin/develop..."

# Turbo se encarga de:
# - Solo correr 'check' y 'test' en paquetes que cambiaron (filter)
# - Usar el cache local si no hubo cambios (velocidad instantánea)
# - Correr en paralelo (concurrence)
npx turbo run check test --filter="...[origin/develop]" --concurrency=100%

if [ $? -ne 0 ]; then
  echo "❌ Error en validaciones (Tipos o Tests). Revisá el reporte de Turbo."
  exit 1
fi

# 2. Healthcheck de Infraestructura (Solo si hay Docker)
# Lo hacemos opcional y rápido
echo "🐳 Verificando Docker..."
node scripts/check-docker.js --quick --strict
if [ $? -ne 0 ]; then
  echo "❌ Error: La infraestructura Docker no está en un estado válido."
  exit 1
fi

echo "🚀 Validación completada en tiempo récord. ¡Buen viaje!"
