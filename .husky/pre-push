#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

export PATH=$PATH:/usr/local/bin:/usr/bin:/bin

echo "=========================================================="
echo "🚀 ANTIGRAVITY: Full Validation Mode (Pre-Push)"
echo "=========================================================="

# 1. Verificación completa de tipos en todo el monorepo
echo "🔍 Verificando integridad de tipos total..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Error de tipos total detectado. No se puede subir código roto."
  exit 1
fi

# 2. Ejecución de Tests Unitarios
echo "🧪 Ejecutando Tests Unitarios..."
npm run test --workspaces --if-present
if [ $? -ne 0 ]; then
  echo "❌ Tests fallidos. Corregí el código antes de pushear."
  exit 1
fi

# 3. Healthcheck de Infraestructura (Docker)
echo "🐳 Verificando salud de contenedores..."
node scripts/check-docker.js
if [ $? -ne 0 ]; then
  echo "❌ Infraestructura inestable. Push cancelado."
  exit 1
fi

echo "🚀 Todo verde. Pusheando a develop..."
