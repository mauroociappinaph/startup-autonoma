#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "=========================================================="
echo "🛡️  ANTIGRAVITY: Evaluando estructura del Mensaje de Commit"
echo "=========================================================="

npx --no -- commitlint --edit "$1"

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ El mensaje de commit NO cumple con la convención."
  echo "   Usa el formato: tipo(scope): mensaje"
  echo "   Ejemplo: feat(auth): agregar login con github"
  exit 1
fi

echo "✅ Formato aceptado."
