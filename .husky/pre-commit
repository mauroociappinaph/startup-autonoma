# Asegurar que los binarios comunes estén en el PATH para Husky
export PATH=$PATH:/usr/local/bin:/usr/bin:/bin

echo "=========================================================="
echo "🛡️  ANTIGRAVITY: Ejecutando verificación de Leyes Sagradas"
echo "=========================================================="

# 0. Sincronizar documentación de estructura (si es necesario)
# echo "📚 Sincronizando estructura del proyecto en la documentación..."
# npm run sync-docs
# git add docs/ AGENTS.md README.md 2>/dev/null

# 1. Correr chequeos de frontend
echo "🔍 Verificando frontend con TSC..."
npm run check --filter=frontend
if [ $? -ne 0 ]; then
  echo "❌ Frontend check fallido. Por favor, revisa los errores de TypeScript localmente."
  exit 1
fi

# 0. Sincronizar documentación de estructura
echo "📚 Sincronizando estructura del proyecto en la documentación..."
npm run sync-docs
# Si hubo cambios en los docs, los agregamos para que entren en este commit
git add docs/ AGENTS.md README.md 2>/dev/null

# 1. Validar reglas de arquitectura en archivos Stages
node scripts/verify-sacred-laws.js
if [ $? -ne 0 ]; then
  echo "❌ Leyes Sagradas violadas. Abortando commit."
  exit 1
fi

# 2. Validar Tipos (TypeScript)
echo "🔍 Verificando integridad de tipos..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Error de tipos detectado. Corregí el código antes de commitear."
  exit 1
fi

# 3. Correr Tests
echo "🧪 Ejecutando Tests Globales (si existen)..."
npm run test --workspaces --if-present
if [ $? -ne 0 ]; then
  echo "❌ Test fail. Abortando commit."
  exit 1
fi

echo "✅ Código aprobado por las Leyes de Arquitectura y los Tests Unitarios. Commiteando..."
npm run sync-arch && git add architecture.md
