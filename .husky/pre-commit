#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "=========================================================="
echo "🛡️  ANTIGRAVITY: Ejecutando verificación de Leyes Sagradas"
echo "=========================================================="

# 1. Validar reglas de arquitectura en archivos Stages
node scripts/verify-sacred-laws.js
if [ $? -ne 0 ]; then
  echo "❌ Leyes Sagradas violadas. Abortando commit."
  exit 1
fi

# 2. Validar Tipos (TypeScript)
echo "🔍 Verificando integridad de tipos..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Error de tipos detectado. Corregí el código antes de commitear."
  exit 1
fi

# 3. Correr Tests
echo "🧪 Ejecutando Tests Globales (si existen)..."
npm run test --workspaces --if-present
if [ $? -ne 0 ]; then
  echo "❌ Test fail. Abortando commit."
  exit 1
fi

echo "✅ Código aprobado por las Leyes de Arquitectura y los Tests Unitarios. Commiteando..."
