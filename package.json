{
  "name": "startup-autonoma",
  "version": "1.0.0",
  "description": "Orquestador de Agentes LangGraph",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "ai-engine"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-engine && [ -d \".venv\" ] && source .venv/bin/activate || echo 'Sin entorno virtual' && uvicorn app.main:app --reload --port 8000",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "turbo": "^2.1.2"
  }
}
