{
  "name": "startup-autonoma",
  "packageManager": "npm@10.5.2",
  "version": "1.0.0",
  "type": "module",
  "description": "Orquestador de Agentes LangGraph",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "ai-engine",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-engine && [ -d \".venv\" ] && source .venv/bin/activate || echo 'Sin entorno virtual' && uvicorn app.main:app --reload --port 8000",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run check",
    "check-laws": "tsx scripts/architecture-audit/runner.ts",
    "check-docker": "node scripts/check-docker.js",
    "verify-srp": "node scripts/verify-srp.js",
    "sync-arch": "node scripts/generate-architecture.js",
    "sync-docs": "node scripts/sync-project-structure.js",
    "infra:check": "npm run check-docker"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.1.2",
    "eslint-plugin-architecture": "file:scripts/architecture-audit/eslint-plugin"
  }
}
