# ================================
# STARTUP AUTÓNOMA — Variables de Entorno
# Copiá esto a .env y completá los valores reales
# ================================

# ─── INFRAESTRUCTURA (CRÍTICAS) ───────────────────────────────────────────────
# El sistema falla de forma explícita si estas no están definidas.

# Redis — URL de conexión. Requerida para BullMQ y el Checkpointer de LangGraph.
REDIS_URL=redis://redis:6379

# ─── BACKEND ──────────────────────────────────────────────────────────────────

# Puerto del servidor Express.
PORT=4000

# Entorno de ejecución.
NODE_ENV=production

# Número de agentes en paralelo (workers de BullMQ).
AGENT_CONCURRENCY=2

# Token de GitHub para operaciones de Git del agente.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ─── BASE DE DATOS ────────────────────────────────────────────────────────────

# Variables para el contenedor de Postgres (usado en docker-compose).
POSTGRES_USER=startup_user
POSTGRES_PASSWORD=CAMBIA_ESTO
POSTGRES_DB=startup_db

# ─── MODELOS DE IA (NVIDIA NIM) ───────────────────────────────────────────────

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
NVIDIA_REASONING_MODEL=z-ai/glm-5.1
NVIDIA_ULTRA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_FLOW_MODEL=meta/llama-3.1-8b-instruct

# Proveedor por defecto para cada rol de LLM.
PRIMARY_REASONING_PROVIDER=nvidia
PRIMARY_ULTRA_PROVIDER=nvidia
PRIMARY_FLOW_PROVIDER=nvidia
PRIMARY_SMART_PROVIDER=nvidia
PRIMARY_FAST_PROVIDER=nvidia

# ─── OBSERVABILIDAD (OPCIONALES) ──────────────────────────────────────────────

# Activar/desactivar OpenTelemetry (true | false).
OTEL_ENABLED=false

# Endpoint del colector OTLP (Jaeger, Grafana, etc.).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Nivel de log de Winston (debug | info | warn | error).
LOG_LEVEL=info

# ─── FRONTEND ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://backend:4000/api

# ─── AI ENGINE ────────────────────────────────────────────────────────────────

# Puerto del servidor gRPC del AI Engine.
AI_ENGINE_PORT=8000
