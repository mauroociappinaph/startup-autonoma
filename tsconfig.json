{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@startup/shared": ["packages/shared/src/index.ts"],
      "@startup/shared/*": ["packages/shared/src/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "packages/shared" },
    { "path": "backend" },
    { "path": "frontend" }
  ],
  "exclude": ["node_modules", "dist"]
}
