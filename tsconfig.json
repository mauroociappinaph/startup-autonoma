{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/types": ["types/index.ts"]
    }
  },
  "include": ["types/**/*"],
  "exclude": ["node_modules", "dist", "backend", "frontend", "ai-engine"]
}
